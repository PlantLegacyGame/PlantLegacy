# Plant Legacy — environment template.
# The server reads process.env directly; it does not load a .env file.
# Export these in your shell or provide them through Compose/hosting.
# Never commit real secrets (DESIGN.md Part 9).

NODE_ENV=local

# Server
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Browser origins allowed to call the API and open the WebSocket (comma-separated).
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Path to the config/ directory. Relative to the process working directory.
# If unset, the server walks up from its working directory to find config/.
# CONFIG_DIR=config

# Postgres (optional locally; required in compose/staging)
DATABASE_URL=postgres://plant:plant@localhost:5432/plant_legacy

# Readiness probe fails when the DB is unreachable and this is true.
READINESS_REQUIRES_DB=true

# Docker Compose auto-loads ops/.env (gitignored) for the staging stack.
# Do not put real values in this template and do not commit ops/.env.
