# Plant Legacy — environment template.
# The server reads process.env directly; it does not load a .env file.
# Export these in your shell or provide them through Compose/hosting.
# Never commit real secrets (DESIGN.md Part 9).

NODE_ENV=local

# Server
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Browser origins allowed to call the API and open the WebSocket (comma-separated).
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Path to the config/ directory. Relative to the process working directory.
# If unset, the server walks up from its working directory to find config/.
# CONFIG_DIR=config

# Postgres (optional locally; required in compose/staging)
DATABASE_URL=postgres://plant:plant@localhost:5432/plant_legacy

# Readiness probe fails when the DB is unreachable and this is true.
READINESS_REQUIRES_DB=true

# Docker Compose auto-loads ops/.env (gitignored) for the staging stack.
# Do not put real values in this template and do not commit ops/.env.

# Account tokens. Required when NODE_ENV=production (the server refuses to boot
# without it); in local/staging an unset value uses a fixed insecure default and
# warns on every start, which means every token is forgeable by anyone who has
# read this file. Generate one and set it before sharing a server with anyone:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=

# Tooling-only variables. The server never reads these; they belong to the scripts
# named beside them, and `pnpm dev` sets PL_SERVER_PORT itself.
# PL_SERVER_PORT=8080        # apps/client/vite.config.ts — dev proxy target
# CLIENT_PORT=4173           # apps/client/scripts/serve.mjs — preview port
# PROXY_ORIGIN=http://127.0.0.1:8080   # apps/client/scripts/serve.mjs — API origin
# PROBE_PORT=8099            # apps/server/scripts/probe-drop-counter.mjs
