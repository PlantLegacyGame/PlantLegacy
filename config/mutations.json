nce_weight":1},"maintenance":{"energy_per_second":0.03,"biomass_per_second":0},"movement":{"reroot_speed":1,"translocate":false,"parts":[],"drift":0},"shed":{"cooldown_s":45,"biomass_penalty_fraction":0.05},"name":"Plump seed","kind":"cosmetic","effects":{"seed_scale_multiplier":1.4},"id":"plump_seed"}},"mutation_tiny_seed":{"type":"object","value":{"gene_tags":["Mutation"],"triggers":{"growth_chance_weight":1},"maintenance":{"energy_per_second":0.02,"biomass_per_second":0},"movement":{"reroot_speed":1,"translocate":false,"parts":[],"drift":0},"shed":{"cooldown_s":45,"biomass_penalty_fraction":0.05},"name":"Tiny seed","kind":"cosmetic","effects":{"seed_scale_multiplier":0.7},"id":"tiny_seed"}},"mutation_upkeep_node_scale":{"type":"number","value":0.05,"range":[0,1],"notes":"Extra upkeep fraction per node the mutation affects (kind-aware: root mutations bill roots)."},"mutation_upkeep_biomass_scale":{"type":"number","value":0.01,"range":[0,0.2],"notes":"Extra upkeep fraction per unit of affected node biomass."},"mutation_upkeep_max_multiplier":{"type":"number","value":3,"range":[1,10],"notes":"Ceiling on the node/biomass upkeep multiplier."},"upkeep_biomass_floor":{"type":"number","value":8,"range":[0,100],"notes":"Biomass level below which unpaid mutation upkeep stops taking tissue. Mutation upkeep never sheds a mutation and never kills the plant: an unpaid bill holds the plant at this floor until it earns again. Dropping a mutation is always the player's decision."},"oversize_decay":{"type":"object","value":{"wilt_per_s":0.02,"leak_per_s":0.05},"notes":"Over-form decay. A size mutation is real tissue, so shedding one leaves the plant heavier than its remaining form can carry. excess tissue is lost at wilt_per_s of itself per second (0.02 halves it in ~35 s), each part thinning as its own mass falls, so the body shrinks back gradually instead of snapping to its old size. Stored water, minerals and energy above the new capacity leak at leak_per_s of the excess per second for the same reason."},"level_up":{"type":"object","value":{"max_level":3,"cards_per_offer":3,"upkeep_per_level":0.15,"card_steps":{"photosynthesis_multiplier":1.12,"energy_upkeep_multiplier":0.92,"growth_cost_multiplier":0.95,"reroot_speed_multiplier":1.08,"growth_speed_multiplier":1.1,"size_multiplier":1.15,"root_size_multiplier":1.15,"leaf_scale_multiplier":1.08,"seed_scale_multiplier":1.08,"water_capacity_multiplier":1.15,"mineral_capacity_multiplier":1.15},"card_labels":{"photosynthesis_multiplier":"Denser chlorophyll","energy_upkeep_multiplier":"Leaner metabolism","growth_cost_multiplier":"Thriftier building","reroot_speed_multiplier":"Quicker crawl","growth_speed_multiplier":"Faster extension","size_multiplier":"Larger form","root_size_multiplier":"Deeper roots","leaf_scale_multiplier":"Broader lamina","seed_scale_multiplier":"Fatter seed","water_capacity_multiplier":"Wider water store","mineral_capacity_multiplier":"Wider mineral store"},"base_energy_cost":20,"energy_cost_per_level":40,"energy_cost_per_biomass":4,"energy_cost_per_biomass_per_level":2,"base_biomass_fraction":0.08,"biomass_fraction_per_level":0.06,"min_biomass_cost":1},"notes":"Mutation levels. A held mutation starts at level 1; the player spends stored resources to raise it and picks one card per level from that mutation's own effect pool. Energy cost = base_energy_cost + energy_cost_per_level per level already gained, plus energy_cost_per_biomass per unit of the plant's biomass (and energy_cost_per_biomass_per_level more per level), so a seedling can afford its first level and a mature plant pays in proportion to what it holds. Biomass cost is base_biomass_fraction of total biomass (+ biomass_fraction_per_level per level), never less than min_biomass_cost. Cards are the effect keys above: a card multiplies its effect by its step, so levelling a size mutation offers size cards and a cosmetic one offers the metabolism cards it can actually use. upkeep_per_level raises the running bill wit