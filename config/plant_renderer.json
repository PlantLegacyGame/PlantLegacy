{
  "_meta": {
    "system": "plant_renderer",
    "version": "0.1.0",
    "schema": "extended-1",
    "owner_task": "C02",
    "status": "draft",
    "notes": "Procedural plant renderer v1: tapered tubes, instanced leaves, shared material, L0/L1 levels"
  },
  "values": {
    "max_nodes_per_plant": {
      "type": "integer",
      "value": 1000,
      "range": [100, 10000],
      "notes": "Maximum nodes (roots + canopy) per plant"
    },
    "root_max_depth": {
      "type": "number",
      "value": 50.0,
      "range": [10.0, 200.0],
      "notes": "Maximum root depth below ground"
    },
    "canopy_max_height": {
      "type": "number",
      "value": 50.0,
      "range": [10.0, 200.0],
      "notes": "Maximum canopy height above ground"
    },
    "node_spacing_min": {
      "type": "number",
      "value": 0.5,
      "range": [0.1, 5.0],
      "notes": "Minimum distance between nodes"
    },
    "node_spacing_max": {
      "type": "number",
      "value": 2.0,
      "range": [0.5, 10.0],
      "notes": "Maximum distance between nodes"
    },
    "branch_probability": {
      "type": "number",
      "value": 0.15,
      "range": [0.0, 1.0],
      "notes": "Probability of branching per node"
    },
    "root_sight_enabled": {
      "type": "boolean",
      "value": true,
      "notes": "Enable Root Sight shader (roots visible underground)"
    },
    "root_sight_opacity": {
      "type": "number",
      "value": 0.6,
      "range": [0.1, 1.0],
      "notes": "Opacity of underground root visualization"
    },
    "canopy_sight_enabled": {
      "type": "boolean",
      "value": true,
      "notes": "Enable canopy visualization above ground"
    },
    "photosynthesis_visualization": {
      "type": "boolean",
      "value": true,
      "notes": "Show photosynthesis activity on canopy"
    },
    "water_flow_visualization": {
      "type": "boolean",
      "value": true,
      "notes": "Show water flow in roots"
    },
    "nutrient_flow_visualization": {
      "type": "boolean",
      "value": true,
      "notes": "Show nutrient flow in roots"
    },
    "shader_quality": {
      "type": "enum",
      "enum": ["low", "medium", "high", "ultra"],
      "value": "high",
      "notes": "Shader quality preset"
    },
    "max_gpu_buffers": {
      "type": "integer",
      "value": 8,
      "range": [2, 16],
      "notes": "Maximum GPU storage buffers for plant data"
    },
    "compute_shader_workgroup_size": {
      "type": "integer",
      "value": 64,
      "range": [16, 256],
      "notes": "Workgroup size for compute shaders"
    },
    "tube_ring_count": {
      "type": "integer",
      "value": 8,
      "range": [4, 16],
      "notes": "Number of radial segments for tube geometry"
    },
    "tube_length_segments": {
      "type": "integer",
      "value": 4,
      "range": [2, 8],
      "notes": "Number of length segments per tube segment"
    },
    "leaf_count_per_node": {
      "type": "integer",
      "value": 3,
      "range": [1, 8],
      "notes": "Number of leaves per canopy node"
    },
    "leaf_size": {
      "type": "number",
      "value": 1.5,
      "range": [0.5, 5.0],
      "notes": "Base leaf size multiplier"
    },
    "leaf_length_width_ratio": {
      "type": "number",
      "value": 2.5,
      "range": [1.5, 5.0],
      "notes": "Leaf length to width ratio"
    },
    "l0_distance": {
      "type": "number",
      "value": 50.0,
      "range": [10.0, 200.0],
      "notes": "L0 detail distance - full geometry with leaves"
    },
    "l1_distance": {
      "type": "number",
      "value": 150.0,
      "range": [50.0, 500.0],
      "notes": "L1 detail distance - tubes only, no leaves"
    },
    "l2_distance": {
      "type": "number",
      "value": 500.0,
      "range": [200.0, 2000.0],
      "notes": "L2 detail distance - simplified representation"
    },
    "triangle_budget_l0": {
      "type": "integer",
      "value": 1500,
      "range": [500, 5000],
      "notes": "Triangle budget per plant at L0"
    },
    "triangle_budget_l1": {
      "type": "integer",
      "value": 800,
      "range": [200, 3000],
      "notes": "Triangle budget per plant at L1"
    },
    "wind_strength": {
      "type": "number",
      "value": 0.3,
      "range": [0.0, 2.0],
      "notes": "Wind animation strength in vertex shader"
    },
    "wind_speed": {
      "type": "number",
      "value": 1.0,
      "range": [0.1, 5.0],
      "notes": "Wind animation speed"
    },
    "health_tint_strength": {
      "type": "number",
      "value": 0.5,
      "range": [0.0, 1.0],
      "notes": "Strength of health-based color tint"
    },
    "mutation_visual_0_name": {
      "type": "string",
      "value": "bioluminescent",
      "notes": "Name of mutation visual signature 0"
    },
    "mutation_visual_0_param": {
      "type": "number",
      "value": 1.0,
      "range": [0.0, 5.0],
      "notes": "Shader parameter for mutation visual 0 (emissive intensity)"
    },
    "mutation_visual_1_name": {
      "type": "string",
      "value": "thickened_bark",
      "notes": "Name of mutation visual signature 1"
    },
    "mutation_visual_1_param": {
      "type": "number",
      "value": 1.5,
      "range": [0.5, 3.0],
      "notes": "Shader parameter for mutation visual 1 (tube thickness multiplier)"
    },
    "mutation_visual_2_name": {
      "type": "string",
      "value": "variegated_leaves",
      "notes": "Name of mutation visual signature 2"
    },
    "mutation_visual_2_param": {
      "type": "number",
      "value": 0.3,
      "range": [0.0, 1.0],
      "notes": "Shader parameter for mutation visual 2 (leaf color variation)"
    }
  }
}