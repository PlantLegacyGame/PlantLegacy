{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-legacy.local/config/_meta/schema.json",
  "title": "Plant Legacy config (extended-1)",
  "description": "Structural schema for config/*.json. The runtime validator in packages/shared/src/config is authoritative: it additionally enforces the rarity ban (RULE_20) and the account_bound flag invariant (RULE_23).",
  "type": "object",
  "required": ["_meta", "values"],
  "additionalProperties": false,
  "properties": {
    "_meta": { "$ref": "#/$defs/meta" },
    "values": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["system", "version", "schema"],
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Must equal the config file name without .json."
        },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
        "schema": { "const": "extended-1" },
        "owner_task": { "type": "string", "pattern": "^(T|C|O|H)\\d+[A-Za-z]?$" },
        "status": { "enum": ["stub", "draft", "active", "deprecated"] },
        "notes": { "type": "string" }
      }
    },
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "value", "range"],
          "properties": {
            "type": { "const": "number" },
            "value": { "type": "number" },
            "range": { "$ref": "#/$defs/range" },
            "notes": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "value", "range"],
          "properties": {
            "type": { "const": "integer" },
            "value": { "type": "integer" },
            "range": { "$ref": "#/$defs/range" },
            "notes": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "boolean" },
            "value": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "string" },
            "value": { "type": "string" },
            "max_length": { "type": "integer", "minimum": 0 },
            "notes": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "enum", "value"],
          "properties": {
            "type": { "const": "enum" },
            "enum": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "value": { "type": "string" },
            "notes": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "array" },
            "value": { "type": "array" },
            "item_type": {
              "enum": ["string", "number", "integer", "boolean", "object"]
            },
            "notes": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "schema", "value"],
          "properties": {
            "type": { "const": "schema_array" },
            "schema": {
              "type": "object",
              "description": "Field name to field type. The special key `enum` lists allowed values for fields typed `enum`.",
              "additionalProperties": {
                "oneOf": [
                  { "enum": ["string", "number", "integer", "boolean", "array", "object", "enum"] },
                  { "type": "array", "items": { "type": "string" } }
                ]
              }
            },
            "value": { "type": "array", "items": { "type": "object" } },
            "notes": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "rows", "cols", "value"],
          "properties": {
            "type": { "const": "matrix" },
            "rows": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "cols": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "value": {
              "type": "array",
              "items": { "type": "array", "items": { "type": "number" } }
            },
            "notes": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "color" },
            "value": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "notes": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "object" },
            "value": { "type": "object" },
            "notes": { "type": "string" }
          }
        }
      ]
    }
  }
}
