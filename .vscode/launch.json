{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Client (Vite)",
      "url": "http://localhost:4173",
      "webRoot": "${workspaceFolder}/apps/client",
      "preLaunchTask": "dev"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Client with Base Path",
      "url": "http://localhost:4173/PlantLegacy/",
      "webRoot": "${workspaceFolder}/apps/client",
      "preLaunchTask": "dev"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Server Only",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/apps/server",
      "preLaunchTask": "dev:server"
    }
  ],
  "compounds": [
    {
      "name": "Start Dev Stack (Server + Client)",
      "configurations": ["Launch Client (Vite)"],
      "preLaunchTask": "dev"
    }
  ]
}
