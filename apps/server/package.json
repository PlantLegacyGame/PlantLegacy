{
  "name": "@plant-legacy/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plant Legacy world server. One process, one World, one Postgres.",
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node ../../tools/watch-server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "probe:drop": "node scripts/probe-drop-counter.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@node-rs/argon2": "^2.2.2",
    "@plant-legacy/shared": "workspace:*",
    "@plant-legacy/weather": "workspace:*",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15"
  }
}
