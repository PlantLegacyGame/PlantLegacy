# dependencies
node_modules/
.pnpm-store/

# build output
dist/
*.tsbuildinfo

# environment / secrets — never committed (DESIGN.md Part 9)
.env
.env.*
!.env.example
secrets.md

# logs and local data
*.log
coverage/
.tmp/
.tmp-dev/
# A stray frame/scratch buffer at the root is not source.
/*.bin

# Screenshots are local verification artifacts, never committed. Root-level
# dumps, the two scratch folders, docs/screenshots and every image under
# docs/verify stay out of the clone; docs may describe a live check but must
# not link or cite an image.
/*.png
/screens/
/screenshots/
/docs/screenshots/
/docs/verify/*.png
/docs/verify/*/

# Abyssal Garden reference checkout (MIT, study only — never imported by code)
/tools/abyssal-garden-reference/

# sim-bots run output
/tools/sim-bots/last-run.json
/tools/bot/last-run/
